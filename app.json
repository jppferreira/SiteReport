{
  "expo": {
    "name": "SiteReport",
    "slug": "sitereport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sitereport",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.sitereport",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Use your camera to capture before and after job photos.",
        "NSPhotoLibraryUsageDescription": "Select photos to include in customer job reports.",
        "NSPhotoLibraryAddUsageDescription": "Save generated report images when required."
      }
    },
    "android": {
      "package": "com.example.sitereport",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      "expo-iap",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SiteReport to capture job photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SiteReport to access photos for job reports."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-your-eas-project-id"
      }
    }
  }
}
