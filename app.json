{
  "expo": {
    "name": "Trade Report",
    "slug": "tradesreport",
    "scheme": "tradesreport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#101310",
    "backgroundColor": "#F7F8F7",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.tradesreport.app",
      "buildNumber": "3",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Trade Report uses your camera to take before and after job photos for your reports.",
        "NSPhotoLibraryUsageDescription": "Trade Report needs access to your photo library so you can add existing photos to a job report.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tradesreport.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#045C42"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E7FCEE",
          "image": "./assets/images/brand-mark.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Trade Report needs access to your photo library so you can add existing photos to a job report.",
          "cameraPermission": "Trade Report uses your camera to take before and after job photos for your reports.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-sharing",
        {
          "ios": {
            "appGroupIdentifier": "group.com.tradesreport.app"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-iap",
      "./plugins/withStoreKitConfig.js",
      "./plugins/withIcloudDocuments.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0c5e1edf-bf91-458d-8ce4-536a5b644367"
      }
    },
    "owner": "joaoferreira500"
  }
}
