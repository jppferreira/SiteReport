# Local tooling / caches (not needed on EAS)
.cursor/
.cursor-tmp/
.expo/
.git/
.github/
dist/
web-build/
website/
node_modules/

# Native folders are regenerated on EAS; keep local copies out of the archive
/ios/
/android/

# Secrets and local signing material
.env
.env*.local
credentials/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
keystore.properties
*.aab
store/play-service-account.json
**/play-service-account.json

# Marketing / store helpers not required to compile the app
store/facebook/
store/threads/
store/asc-placeholders/
store/screenshots/
store/ios-headers/
store/play/
store/*.aab
store/*.md
tradesreport-*.aab
qrcode-terminal-*.tgz
pnpm-lock.yaml
pnpm-workspace.yaml

# Whisper weights are downloaded on-device at first voice use — never ship in the binary
assets/whisper/
assets/whisper/**
*.bin
*.partial

# Misc
*.tsbuildinfo
.DS_Store
npm-debug.*
yarn-debug.*
yarn-error.*
example
